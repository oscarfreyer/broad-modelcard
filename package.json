{
  "name": "atlas-mvp-js",
  "private": true,
  "version": "0.5.2",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs dev",
    "api": "node scripts/dev.mjs api",
    "build": "vite build --config frontend/vite.config.js",
    "build:static": "node scripts/static/build.mjs",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "node --test",
    "test:backend": "node scripts/run-backend-tests.mjs",
    "preview": "node scripts/dev.mjs preview",
    "validate-seed": "node scripts/validate-seed.mjs",
    "demo": "node scripts/demo.mjs run",
    "demo:build": "node scripts/demo.mjs build",
    "ontologies:fetch": "node scripts/ontologies/fetch.mjs",
    "ontologies:import": "node scripts/ontologies/import.mjs",
    "static:record": "node scripts/static/record.mjs"
  },
  "dependencies": {
    "jspdf": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
